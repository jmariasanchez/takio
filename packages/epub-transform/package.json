{
  "name": "@takio/epub-transform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --sourcemap && bunx tsc -p tsconfig.json --emitDeclarationOnly",
    "check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.2"
  }
}
