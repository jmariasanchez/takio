{
  "name": "@takio/library-store-bun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "bun run --filter '@takio/library-contract' build && bun build ./src/index.ts --outdir ./dist --target bun --sourcemap && bunx tsc -p tsconfig.json --emitDeclarationOnly",
    "check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@takio/core": "workspace:*",
    "@takio/library-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.8.2"
  }
}
