{
  "name": "@takio/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "takio": "./dist/main.js"
  },
  "scripts": {
    "build": "bun run --filter '@takio/library-store-bun' build && bun build ./src/main.ts --outdir ./dist --target bun --sourcemap",
    "check": "bunx tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "start": "bun src/main.ts"
  },
  "dependencies": {
    "@takio/core": "workspace:*",
    "@takio/library-store-bun": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.2"
  }
}
