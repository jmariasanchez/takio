{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Takio",
  "version": "0.1.0",
  "identifier": "com.takio.desktop",
  "build": {
    "beforeDevCommand": "bun run build:engine && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:engine && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Takio",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/Takio/covers/**",
          "$LOCALDATA/Takio/covers/**",
          "$DATA/takio/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/takio-library-engine"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
