{
  "name": "@takio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Takio local-first ebook library desktop application",
  "author": "Takio contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "bun scripts/dev-electron.ts",
    "build": "bun run build:engine && tsc -b && vite build && bun run build:electron",
    "build:electron": "bun scripts/build-electron.ts",
    "build:engine": "bun run --filter '@takio/library-store-bun' build && bun scripts/build-library-engine.ts",
    "check": "tsc -b --pretty false",
    "test": "bun test",
    "package": "bun run build && electron-builder",
    "package:dir": "bun run build && electron-builder --dir"
  },
  "dependencies": {
    "@takio/core": "workspace:*",
    "@takio/library-contract": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  },
  "build": {
    "appId": "com.takio.desktop",
    "productName": "Takio",
    "asar": true,
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "extraResources": [{ "from": "resources/bin", "to": "bin" }],
    "directories": { "output": "release", "buildResources": "build" },
    "mac": {
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns"
    },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "linux": { "target": ["AppImage", "deb"], "category": "Office" }
  }
}
